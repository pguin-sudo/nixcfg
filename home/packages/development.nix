{ lib, pkgs, ... }:
{
  home.packages = with pkgs; [
    # Nix
    nixd
    nil

    # Python
    (lib.hiPrio python313)
    python314
    poetry
    python313Packages.pytest

    # Rust
    rustup
    bacon

    # JS
    nodejs_24
    bun

    # C
    clang

    # Tools
    docker-compose
    openssl
    pgadmin4-desktopmode
    gnumake
    insomnia

    # AI

    # Gamedev
    godot_4

    # Devops
    ansible
    opentofu

    # IoT
    usbutils

    # DB
    dbgate
  ];

  services.remmina = {
    enable = true;
    systemdService.enable = false;
  };

  #programs.zed-editor.enable = true;

  programs.codex = {
    enable = true;

    mutableSettings = true;

    context = ''
      Отвечай на русском языке.
      Код, имена идентификаторов, сообщения об ошибках и docstrings - на английском
      (если в проекте не принято иное).

      Перед любыми изменениями обязательно изучи:
      - существующий код и его стиль
      - архитектуру и принятые паттерны
      - соглашения проекта (именование, структура, обработка ошибок, типизация)

      Соблюдай стиль и подходы проекта. Не навязывай свои предпочтения.

      Пиши поддерживаемый и понятный код.
      Ограничивай изменения строго рамками задачи.
      Не делай рефакторинг «заодно» и не трогай соседний код без необходимости.

      Если задачу можно решить только через костыль (временное/грязное решение)
      без рефакторинга - обязательно явно предложи этот рефакторинг.
      Объясни, почему текущее решение является костылём и что именно нужно
      улучшить. Не оставляй костыль без комментария и предложения по исправлению.

      Если любая деталь реализации хоть сколько-нибудь неоднозначна -
      обязательно задавай уточняющие вопросы перед тем, как писать код.
      Лучше лишний раз уточнить, чем сделать неправильное предположение.

      Если задача поставлена некорректно, неполно или ведёт к плохому решению -
      можно и нужно оспорить её выполнение.
      Предложи альтернативный способ достичь того же результата,
      объясни, почему он лучше, и дождись согласия перед реализацией.
      Не выполняй заведомо плохо сформулированную задачу "как есть".

      Принципы:
      - SOLID, KISS, DRY
      - Не вводи абстракции и универсальные решения без реальной практической необходимости
      - Не усложняй код ради формального соблюдения принципов
      - Если код работает неочевидно - лучше переписать его проще (KISS важнее "красоты")

      Комментарии и документация:
      - Не пиши комментарии, которые просто пересказывают код
      - Комментируй только неочевидные решения и сложную логику,
        которую нельзя разумно упростить
      - Предпочитай короткие docstrings вместо комментариев
      - Docstrings не нужны, если код и так очевиден
      - Комментарии должны быть краткими и содержать только ASCII + русские буквы
      - Никогда не добавляй copyright-заголовки

      Работа с данными:
      - dict запрещён как основная модель данных, DTO, схема или сущность
      - Особенно критично, если данные читаются или изменяются приложением (in-out)
      - Обычный dict допустим только как локальный временный контейнер
        или настоящий mapping (ключ → значение)

      Дополнительно:
      - Не создавай коммиты
      - Не добавляй новые зависимости без крайней необходимости
      - Используй уже существующие в проекте библиотеки и утилиты
      - Если в проекте есть тесты - обновляй или добавляй их вместе с изменениями
      - При исправлении бага по возможности добавляй регрессионный тест
      - Следуй принятому в проекте стилю обработки ошибок и типизации
      - Не хардкодь секреты, токены и чувствительные данные
    '';

    settings = {
      project_doc_fallback_filenames = [ "PROJECT.md" ];
    };
  };
}
